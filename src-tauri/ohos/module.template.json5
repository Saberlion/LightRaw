{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
        "2in1",
        "tablet",
        "phone"
      ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "supportWindowMode": [
          "fullscreen",
          "split",
          "floating"
        ],
        "minWindowWidth": 480,
        "minWindowHeight": 420,
        "backgroundModes": [
          "dataTransfer"
        ],
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "entities": [
              "entity.system.default"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "general.raw-image"
              },
              {
                "scheme": "content",
                "type": "general.raw-image"
              },
              {
                "scheme": "",
                "type": "general.raw-image"
              },
              {
                "scheme": "file",
                "type": "general.image"
              },
              {
                "scheme": "content",
                "type": "general.image"
              },
              {
                "scheme": "",
                "type": "general.image"
              },
              {
                "scheme": "file",
                "type": "general.jpeg"
              },
              {
                "scheme": "content",
                "type": "general.jpeg"
              },
              {
                "scheme": "",
                "type": "general.jpeg"
              },
              {
                "scheme": "file",
                "type": "general.png"
              },
              {
                "scheme": "content",
                "type": "general.png"
              },
              {
                "scheme": "",
                "type": "general.png"
              },
              {
                "scheme": "file",
                "type": "general.tiff"
              },
              {
                "scheme": "content",
                "type": "general.tiff"
              },
              {
                "scheme": "",
                "type": "general.tiff"
              },
              {
                "scheme": "file",
                "type": "general.gif"
              },
              {
                "scheme": "content",
                "type": "general.gif"
              },
              {
                "scheme": "",
                "type": "general.gif"
              },
              {
                "scheme": "file",
                "type": "com.microsoft.bmp"
              },
              {
                "scheme": "content",
                "type": "com.microsoft.bmp"
              },
              {
                "scheme": "",
                "type": "com.microsoft.bmp"
              }
            ]
          },
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "entities": [
              "entity.system.default"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "general.raw-image"
              },
              {
                "scheme": "content",
                "type": "general.raw-image"
              },
              {
                "scheme": "",
                "type": "general.raw-image"
              },
              {
                "scheme": "file",
                "type": "general.image"
              },
              {
                "scheme": "content",
                "type": "general.image"
              },
              {
                "scheme": "",
                "type": "general.image"
              },
              {
                "scheme": "file",
                "type": "general.jpeg"
              },
              {
                "scheme": "content",
                "type": "general.jpeg"
              },
              {
                "scheme": "",
                "type": "general.jpeg"
              },
              {
                "scheme": "file",
                "type": "general.png"
              },
              {
                "scheme": "content",
                "type": "general.png"
              },
              {
                "scheme": "",
                "type": "general.png"
              },
              {
                "scheme": "file",
                "type": "general.tiff"
              },
              {
                "scheme": "content",
                "type": "general.tiff"
              },
              {
                "scheme": "",
                "type": "general.tiff"
              },
              {
                "scheme": "file",
                "type": "general.gif"
              },
              {
                "scheme": "content",
                "type": "general.gif"
              },
              {
                "scheme": "",
                "type": "general.gif"
              },
              {
                "scheme": "file",
                "type": "com.microsoft.bmp"
              },
              {
                "scheme": "content",
                "type": "com.microsoft.bmp"
              },
              {
                "scheme": "",
                "type": "com.microsoft.bmp"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_WIFI_INFO"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        "name": "ohos.permission.WRITE_IMAGEVIDEO",
        "reason": "$string:perm_write_imagevideo",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:perm_download_dir",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:perm_documents_dir",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DESKTOP_DIRECTORY",
        "reason": "$string:perm_desktop_dir",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.MEDIA_LOCATION",
        "reason": "$string:perm_media_location",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
